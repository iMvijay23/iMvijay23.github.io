---
// Activation-steering playground: drag α, watch a (hand-written) output change.
// Data: content/steering.yaml
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import Prompt from './Prompt.astro';

// keep the order they're written in steering.yaml
const order = [...fs.readFileSync('content/steering.yaml', 'utf8').matchAll(/^- id:\s*(\S+)/gm)].map((m) => m[1]);
const concepts = (await getCollection('steering'))
  .map((c) => ({ id: c.id, ...c.data }))
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const first = concepts[0];
const LAYERS = 24;
---
{first && (
  <section class="steer" data-concepts={JSON.stringify(concepts)}>
    <Prompt tag="h2" cmd={`python steer.py --layer ${first.layer} --concept ${first.id}`} />

    <div class="steer-box">
      <div class="steer-tabs" role="tablist" aria-label="Concept direction">
        {concepts.map((c, i) => (
          <button type="button" role="tab" data-id={c.id} aria-selected={i === 0 ? 'true' : 'false'}>{c.label}</button>
        ))}
      </div>

      <p class="steer-line"><span class="steer-k">prompt&gt;</span> <span class="steer-prompt">{first.prompt}</span></p>

      <div class="steer-ctrl">
        <label for="alpha" class="steer-k">α</label>
        <input id="alpha" type="range" min="-4" max="4" step="2" value="0" aria-describedby="alpha-val" />
        <output id="alpha-val" class="steer-alpha">+0.0</output>
      </div>

      <div class="steer-layers" aria-hidden="true">
        {Array.from({ length: LAYERS }, (_, i) => <span data-l={i} />)}
        <span class="steer-layer-label">L<b>{first.layer}</b></span>
      </div>

      <p class="steer-line steer-out" aria-live="polite"><span class="steer-k">output&gt;</span> <span class="steer-text"></span></p>

      <p class="steer-foot">h<sub>ℓ</sub> ← h<sub>ℓ</sub> + α·v<sub>concept</sub> · illustrative: the outputs are hand-written, not from a live model</p>
    </div>
  </section>
)}

<script>
  type Concept = { id: string; label: string; layer: number; prompt: string; outputs: string[] };
  const root = document.querySelector<HTMLElement>('.steer');
  if (root) {
    const concepts: Concept[] = JSON.parse(root.dataset.concepts!);
    const slider = root.querySelector<HTMLInputElement>('#alpha')!;
    const alphaOut = root.querySelector('#alpha-val')!;
    const text = root.querySelector<HTMLElement>('.steer-text')!;
    const promptEl = root.querySelector('.steer-prompt')!;
    const cmd = root.querySelector('.p-cmd')!;
    const cells = [...root.querySelectorAll<HTMLElement>('.steer-layers [data-l]')];
    const layerLabel = root.querySelector('.steer-layer-label b')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.steer-tabs button')];
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = concepts[0];
    let timer = 0;

    // "{token}" → highlighted span; everything else escaped
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
    const toHtml = (s: string) => esc(s).replace(/\{([^}]+)\}/g, '<mark>$1</mark>');

    function type(s: string) {
      clearInterval(timer);
      const html = toHtml(s);
      if (still) { text.innerHTML = html; return; }
      // reveal character by character without breaking the <mark> tags
      const parts = html.split(/(<\/?mark>)/);
      let shown = 0;
      const total = s.replace(/[{}]/g, '').length;
      timer = window.setInterval(() => {
        shown += 3;
        let left = shown, out = '';
        for (const p of parts) {
          if (p.startsWith('<')) { out += p; continue; }
          out += p.slice(0, Math.max(0, left));
          left -= p.length;
        }
        text.innerHTML = out + (shown < total ? '<span class="steer-caret"></span>' : '');
        if (shown >= total) clearInterval(timer);
      }, 12);
    }

    function render() {
      const a = Number(slider.value);
      const idx = (a + 4) / 2;
      alphaOut.textContent = (a >= 0 ? '+' : '') + a.toFixed(1);
      root!.style.setProperty('--mag', String(Math.abs(a) / 4));
      root!.dataset.sign = a > 0 ? 'pos' : a < 0 ? 'neg' : 'zero';
      cells.forEach((c, i) => {
        // the injected direction fades in at the steered layer and decays downstream
        const d = i - current.layer;
        c.style.opacity = String(d < 0 ? 0.12 : 0.12 + 0.88 * (Math.abs(a) / 4) * Math.exp(-d / 5));
        c.classList.toggle('at', d === 0);
      });
      type(current.outputs[idx]);
    }

    function select(id: string) {
      current = concepts.find((c) => c.id === id) ?? concepts[0];
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.id === current.id)));
      promptEl.textContent = current.prompt;
      cmd.textContent = `python steer.py --layer ${current.layer} --concept ${current.id}`;
      layerLabel.textContent = String(current.layer);
      slider.value = '0';
      render();
    }

    slider.addEventListener('input', render);
    tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.id!)));
    render();
  }
</script>

<style>
  .steer-box {
    border: 1px solid var(--line); background: var(--bg-soft); border-radius: 4px;
    padding: 0.9rem 1rem 0.7rem; font-size: 0.88rem;
  }
  .steer-tabs { display: flex; flex-wrap: wrap; gap: 0.2rem 0.8rem; margin-bottom: 0.7rem; }
  .steer-tabs button {
    font: inherit; background: none; border: 0; padding: 0; cursor: pointer; color: var(--muted);
  }
  .steer-tabs button::before { content: '[ ] '; }
  .steer-tabs button[aria-selected='true'] { color: var(--accent); }
  .steer-tabs button[aria-selected='true']::before { content: '[x] '; }
  .steer-line { margin: 0.4rem 0; }
  .steer-k { color: var(--accent-2); }
  .steer-ctrl { display: flex; align-items: center; gap: 0.8rem; margin: 0.8rem 0 0.4rem; }
  .steer-ctrl input { flex: 1; min-width: 0; accent-color: var(--accent); }
  .steer-alpha { min-width: 4.5ch; text-align: right; font-weight: 700; }
  [data-sign='neg'] .steer-alpha { color: #3b82f6; }
  [data-sign='pos'] .steer-alpha { color: #dc2626; }
  .steer-layers { display: flex; align-items: center; gap: 3px; margin: 0.3rem 0 0.6rem; }
  .steer-layers span[data-l] {
    flex: 1; height: 10px; border-radius: 2px; background: var(--muted); opacity: 0.12;
    transition: opacity 0.25s;
  }
  [data-sign='neg'] .steer-layers span[data-l] { background: #3b82f6; }
  [data-sign='pos'] .steer-layers span[data-l] { background: #dc2626; }
  .steer-layers span.at { outline: 1px solid var(--fg); outline-offset: 1px; }
  .steer-layer-label { font-size: 0.75rem; color: var(--muted); margin-left: 0.4rem; }
  .steer-out { min-height: 7em; }
  .steer-text :global(mark) {
    color: inherit; border-radius: 2px; padding: 0 1px;
    background: color-mix(in srgb, var(--accent) calc(12% + 28% * var(--mag, 0)), transparent);
  }
  [data-sign='pos'] .steer-text :global(mark) { background: color-mix(in srgb, #dc2626 calc(10% + 30% * var(--mag, 0)), transparent); }
  [data-sign='neg'] .steer-text :global(mark) { background: color-mix(in srgb, #3b82f6 calc(10% + 30% * var(--mag, 0)), transparent); }
  .steer-text :global(.steer-caret) {
    display: inline-block; width: 0.55em; height: 1em; vertical-align: -0.12em; background: var(--accent);
  }
  .steer-foot { margin: 0.6rem 0 0; font-size: 0.72rem; color: var(--muted); }
</style>
