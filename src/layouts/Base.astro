---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../config';
import { getNav } from '../lib/util';

interface Props { title?: string; description?: string }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const nav = await getNav();
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL(site.ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}. A grid of neurons across layers, with a steering vector added at one layer.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(site.ogImage, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="notes" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/">~/{site.handle}</a>
        <nav>
          {nav.map((n) => <a href={n.href} class:list={{ active: active(n.href) }}>[{n.title}]</a>)}
          <ThemeToggle />
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="p-dim">·</span>
        <a href="/rss.xml">rss</a>
        <span class="p-dim">·</span>
        <span class="p-dim">built with astro, written in markdown</span>
        {site.nowPlaying.text && (
          <span class="now-playing">♪ now playing: <a href={site.nowPlaying.href} target="_blank" rel="noopener">{site.nowPlaying.text}</a></span>
        )}
      </footer>
    </div>
  </body>
</html>
