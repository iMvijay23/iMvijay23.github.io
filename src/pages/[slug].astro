---
// Every content/pages/<slug>.md (except home.md) becomes /<slug>
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prompt from '../components/Prompt.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => p.id !== 'home');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <Prompt path={`/${page.id}`} cmd={`cat ${page.id}.md`} />
  <h1>{page.data.title}</h1>
  <article class="prose"><Content /></article>
</Base>
